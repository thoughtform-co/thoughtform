# ==============================================
# Thoughtform Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
#
# The canonical typed schema lives in `lib/env.ts`. Add new
# variables there AND here so they are documented and the runtime
# accessors stay typed.

# ----------------------------------------------
# Supabase Configuration
# ----------------------------------------------
# Required for database features (auth, content storage)
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key for admin operations.
# REQUIRED for any mutating API route, in every environment — bypasses RLS,
# never expose to the browser. There is NO development bypass (ADR-003,
# amendment 2026-09-24): `next dev` listens on the LAN by default and a dev
# server with this key IS the production database, so admin routes are gated
# under `next dev` exactly as they are on Vercel.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------
# Auth allowlist (single-admin model, ADR-003)
# ----------------------------------------------
# Required in production. Both client gates (`AdminGate`,
# `AdminGroupLayout`) and server routes (`isAuthorized`) compare
# against this lowercased value.
# NEXT_PUBLIC_ALLOWED_EMAIL=admin@example.com

# The owner's pass (ADR-117) — the signed cookie that opens /arcs, the
# overview only the owner may see. Optional: left empty, the pass key is
# derived from SUPABASE_SERVICE_ROLE_KEY. When set it must be at least 32
# characters, or the gate fails closed (the owner's own /arcs is a 404).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OWNER_PASS_SECRET=
# OWNER_GATE=enforce   # turn the gate on under `next dev` (it is always on in production)

# ----------------------------------------------
# Vercel KV (Optional)
# ----------------------------------------------
# Required for particle system configuration persistence
# Auto-populated when you link KV in Vercel dashboard
# For local dev, the app falls back to defaults

# KV_URL=your-kv-url
# KV_REST_API_URL=your-kv-rest-url
# KV_REST_API_TOKEN=your-kv-token
# KV_REST_API_READ_ONLY_TOKEN=your-kv-read-only-token

# ----------------------------------------------
# AI providers (server-only secrets)
# ----------------------------------------------
# Anthropic — survey/foundry chat, briefing, captioning, style derivation.
# Required for /api/survey/chat, /api/survey/analyze, /api/foundry/chat,
# /api/survey/briefing, /api/survey/style/derive,
# /api/survey/segments/label, /api/survey/annotations/caption.
# ANTHROPIC_API_KEY=your-anthropic-key

# Voyage AI — embeddings used by the survey + foundry RAG paths.
# Required for /api/survey/embed, /api/survey/search, /api/foundry/chat.
# VOYAGE_API_KEY=your-voyage-key
# VOYAGE_EMBED_MODEL=voyage-3.5

# Replicate — SAM-2 segmentation for /api/survey/segments/generate.
# REPLICATE_API_TOKEN=your-replicate-token
# REPLICATE_SAM2_MODEL=meta/sam-2-large

# ----------------------------------------------
# Figma Bridge (Optional)
# ----------------------------------------------
# Required for Figma Bridge integration (design token sync, SVG export)
# Create a Personal Access Token at: Figma > Settings > Security > Personal access tokens
# Scopes needed: file_content:read, file_metadata:read

# FIGMA_ACCESS_TOKEN=your-figma-personal-access-token
# FIGMA_FILE_KEY=XO8yGN90SfxiG1hmYPGYXn

# Public file key for the astrogation overlay (browser-readable).
# NEXT_PUBLIC_FIGMA_FILE_KEY=XO8yGN90SfxiG1hmYPGYXn

# ----------------------------------------------
# Custom services
# ----------------------------------------------
# Local SAM-2 segmenter (when Replicate isn't desirable in dev).
# SEGMENTER_URL=http://localhost:8001

# ----------------------------------------------
# Build / runtime knobs
# ----------------------------------------------
# Set NEXT_OUTPUT_EXPORT=1 to build the static-only marketing export
# (used by scripts/package-homepage-static.mjs).
# Set ANALYZE=true to surface the bundle analyzer report.
