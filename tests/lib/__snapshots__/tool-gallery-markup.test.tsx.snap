exports[`ToolGallery markup (ADR-072 pin) > renders each station byte-for-byte as pinned > station 0 1`] = `"<div class="fl-con fl-plate fl-plate--tools"><div class="fl-con__console"><div class="fl-con__rail" role="tablist" aria-label="Production tools" data-n="4" style="--rail-n:4;--rail-i:0"><button type="button" role="tab" class="fl-con__stn" data-on="true" aria-selected="true" tabindex="0"><i aria-hidden="true"></i><b>BRIEFING AGENT</b></button><button type="button" role="tab" class="fl-con__stn" aria-selected="false" tabindex="-1"><i aria-hidden="true"></i><b>IMAGE &amp; VIDEO</b></button><button type="button" role="tab" class="fl-con__stn" aria-selected="false" tabindex="-1"><i aria-hidden="true"></i><b>UGC DUBBER</b></button><button type="button" role="tab" class="fl-con__stn" aria-selected="false" tabindex="-1"><i aria-hidden="true"></i><b>STUDIO PM</b></button><i class="fl-con__spine" aria-hidden="true"></i></div><div class="fl-con__mid"><div class="fl-con__field"><div class="fl-toolbody"><div class="fl-bay"><div class="fl-bay__top" aria-hidden="true"><span>FEED · IN SERVICE <em>2025 —</em></span><span>WALKTHROUGH · <em>1:20</em></span></div><button type="button" class="fl-shot" aria-haspopup="dialog" aria-label="Watch the Briefing Agent walkthrough — 1:20. Interface, drawn."><span class="fl-shot__frame"><div class="fl-wire fl-wire--mimir" aria-hidden="true"><div class="fl-wire__in"><div class="fl-wire__mi-chrome"><i class="fl-wire__mi-ttl"></i><span class="fl-wire__mi-seg"><i data-on=""></i><i></i></span></div><div class="fl-wire__mi-body"><div class="fl-wire__mi-rail"><span class="fl-wire__lbl">INPUT</span><span class="fl-wire__mi-src"><span class="fl-wire__lbl fl-wire__lbl--grn">ADS DATA</span><i></i><i></i></span><span class="fl-wire__mi-src"><span class="fl-wire__lbl fl-wire__lbl--grn">REVIEWS</span><i></i><i></i></span><span class="fl-wire__mi-src"><span class="fl-wire__lbl fl-wire__lbl--grn">REDDIT</span><i></i><i></i></span><span class="fl-wire__mi-src"><span class="fl-wire__lbl fl-wire__lbl--grn">BLOGS</span><i></i><i></i></span><span class="fl-wire__cta"><span class="fl-wire__lbl">GENERATE BRIEFINGS</span></span></div><div class="fl-wire__mi-brief"><span class="fl-wire__lbl">BRIEFING</span><span class="fl-wire__mi-sec"><b class="fl-wire__mi-kick"><i class="fl-wire__mi-dot"></i><i class="fl-wire__mi-kbar"></i></b><i class="fl-wire__mi-line"></i><i class="fl-wire__mi-line fl-wire__mi-line--short"></i></span><span class="fl-wire__mi-sec"><b class="fl-wire__mi-kick"><i class="fl-wire__mi-dot"></i><i class="fl-wire__mi-kbar"></i></b><i class="fl-wire__mi-line fl-wire__mi-line--mid"></i><i class="fl-wire__mi-line"></i></span><span class="fl-wire__mi-sec"><b class="fl-wire__mi-kick"><i class="fl-wire__mi-dot"></i><i class="fl-wire__mi-kbar"></i></b><b class="fl-wire__mi-checks"><i data-on=""></i><i></i><i></i></b></span></div><div class="fl-wire__mi-ad"><span class="fl-wire__lbl">AD</span><span class="fl-wire__mi-adframe"><span class="fl-wire__mi-adimg"><svg viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet"><circle cx="15.5" cy="8" r="2.6"></circle><path d="M2,19 L9.5,11 L14,15.5 L17.5,12.5 L22,17"></path></svg></span><i class="fl-wire__mi-adhead"></i><i class="fl-wire__mi-adhead fl-wire__mi-adhead--short"></i><i class="fl-wire__mi-adcta"></i></span></div></div></div></div></span><span class="fl-shot__bar" aria-hidden="true"><i class="fl-shot__cue"></i>Watch walkthrough<b>1:20</b></span></button></div><ul class="fl-detail"><li class="fl-detail__plate" style="animation-delay:120ms"><span class="fl-detail__in"><span class="fl-detail__t">Permissioned graph</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Customer voice, paid performance, competitor ads, and prior strategy as one substrate.</span></span></li><li class="fl-detail__plate" style="animation-delay:175ms"><span class="fl-detail__in"><span class="fl-detail__t">Proactive briefing</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Relevant insights surface while strategists compose the brief, not after another search pass.</span></span></li><li class="fl-detail__plate" style="animation-delay:230ms"><span class="fl-detail__in"><span class="fl-detail__t">Headless substrate</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">The same interpretation layer answers the web app, Claude, Cursor, Slack, and ChatGPT.</span></span></li><li class="fl-detail__plate" style="animation-delay:285ms"><span class="fl-detail__in"><span class="fl-detail__t">Shared BI layer</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Expanded from Creative Strategy into Insights and Product Marketing use cases.</span></span></li></ul></div></div></div></div></div>"`;

exports[`ToolGallery markup (ADR-072 pin) > renders each station byte-for-byte as pinned > station 1 1`] = `"<div class="fl-con fl-plate fl-plate--tools"><div class="fl-con__console"><div class="fl-con__rail" role="tablist" aria-label="Production tools" data-n="4" style="--rail-n:4;--rail-i:1"><button type="button" role="tab" class="fl-con__stn" aria-selected="false" tabindex="-1"><i aria-hidden="true"></i><b>BRIEFING AGENT</b></button><button type="button" role="tab" class="fl-con__stn" data-on="true" aria-selected="true" tabindex="0"><i aria-hidden="true"></i><b>IMAGE &amp; VIDEO</b></button><button type="button" role="tab" class="fl-con__stn" aria-selected="false" tabindex="-1"><i aria-hidden="true"></i><b>UGC DUBBER</b></button><button type="button" role="tab" class="fl-con__stn" aria-selected="false" tabindex="-1"><i aria-hidden="true"></i><b>STUDIO PM</b></button><i class="fl-con__spine" aria-hidden="true"></i></div><div class="fl-con__mid"><div class="fl-con__field"><div class="fl-toolbody"><div class="fl-bay"><div class="fl-bay__top" aria-hidden="true"><span>FEED · IN SERVICE <em>2025 —</em></span><span>WALKTHROUGH · <em>1:22</em></span></div><button type="button" class="fl-shot" aria-haspopup="dialog" aria-label="Watch the AI Image &amp; Video Suite walkthrough — 1:22. Interface, drawn."><span class="fl-shot__frame"><div class="fl-wire fl-wire--vesper" aria-hidden="true"><div class="fl-wire__in"><div class="fl-wire__chrome"><span class="fl-wire__ttl"><i class="fl-wire__ttl-bar"></i><i class="fl-wire__ttl-pill"></i></span></div><div class="fl-wire__body"><div class="fl-wire__rail"><i class="fl-wire__new"><svg viewBox="0 0 12 12"><path d="M6,3.4 V8.6 M3.4,6 H8.6"></path></svg></i><i class="fl-wire__sess" data-on=""></i><i class="fl-wire__sess"></i><i class="fl-wire__sess"></i></div><div class="fl-wire__main"><div class="fl-wire__gal"><div class="fl-wire__card"><span class="fl-wire__lines"><span class="fl-wire__lbl">PROMPT</span><i></i><i></i><i></i><span class="fl-wire__meta"><b class="fl-wire__dot"></b><b class="fl-wire__dot"></b><b class="fl-wire__mb"></b><b class="fl-wire__mb"></b></span><span class="fl-wire__lbl fl-wire__model">NANO BANANA</span></span></div><span class="fl-wire__tile"><svg class="fl-wire__tileglyph" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet"><circle cx="15.5" cy="8" r="2.6"></circle><path d="M2,19 L9.5,11 L14,15.5 L17.5,12.5 L22,17"></path></svg></span></div><div class="fl-wire__dock"><div class="fl-wire__comp"><i class="fl-wire__say"><b>Loop Switch, golden hour</b></i><span class="fl-wire__enh"><svg class="fl-wire__wand" viewBox="0 0 12 12"><path d="M6,0 L7.15,4.85 L12,6 L7.15,7.15 L6,12 L4.85,7.15 L0,6 L4.85,4.85 Z"></path></svg><span class="fl-wire__lbl fl-wire__lbl--grn">ENHANCE PROMPT</span></span><span class="fl-wire__cta"><span class="fl-wire__lbl">GENERATE</span></span></div></div></div></div></div></div></span><span class="fl-shot__bar" aria-hidden="true"><i class="fl-shot__cue"></i>Watch walkthrough<b>1:22</b></span></button></div><ul class="fl-detail"><li class="fl-detail__plate" style="animation-delay:120ms"><span class="fl-detail__in"><span class="fl-detail__t">Prompt enhancement</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Claude refines visual prompts using the Loop product catalogue.</span></span></li><li class="fl-detail__plate" style="animation-delay:175ms"><span class="fl-detail__in"><span class="fl-detail__t">Multi-model generation</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Gemini Flash Image, Veo 3.1, Seedream, Kling under one tab.</span></span></li><li class="fl-detail__plate" style="animation-delay:230ms"><span class="fl-detail__in"><span class="fl-detail__t">Image-to-video</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Animate a still without leaving the canvas. Small fix, big flow.</span></span></li><li class="fl-detail__plate" style="animation-delay:285ms"><span class="fl-detail__in"><span class="fl-detail__t">Headless REST + MCP</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Same Skill behind Claude.ai and the in-product enhance button.</span></span></li></ul></div></div></div></div></div>"`;

exports[`ToolGallery markup (ADR-072 pin) > renders each station byte-for-byte as pinned > station 2 1`] = `"<div class="fl-con fl-plate fl-plate--tools"><div class="fl-con__console"><div class="fl-con__rail" role="tablist" aria-label="Production tools" data-n="4" style="--rail-n:4;--rail-i:2"><button type="button" role="tab" class="fl-con__stn" aria-selected="false" tabindex="-1"><i aria-hidden="true"></i><b>BRIEFING AGENT</b></button><button type="button" role="tab" class="fl-con__stn" aria-selected="false" tabindex="-1"><i aria-hidden="true"></i><b>IMAGE &amp; VIDEO</b></button><button type="button" role="tab" class="fl-con__stn" data-on="true" aria-selected="true" tabindex="0"><i aria-hidden="true"></i><b>UGC DUBBER</b></button><button type="button" role="tab" class="fl-con__stn" aria-selected="false" tabindex="-1"><i aria-hidden="true"></i><b>STUDIO PM</b></button><i class="fl-con__spine" aria-hidden="true"></i></div><div class="fl-con__mid"><div class="fl-con__field"><div class="fl-toolbody"><div class="fl-bay"><div class="fl-bay__top" aria-hidden="true"><span>FEED · IN SERVICE <em>2026 —</em></span><span>WALKTHROUGH · <em>1:09</em></span></div><button type="button" class="fl-shot" aria-haspopup="dialog" aria-label="Watch the UGC Dubber walkthrough — 1:09. Interface, drawn."><span class="fl-shot__frame"><div class="fl-wire fl-wire--babylon" aria-hidden="true"><div class="fl-wire__in"><div class="fl-wire__ba-chrome"><span class="fl-wire__ba-flow"><span class="fl-wire__ba-step"><svg class="fl-wire__ba-mark" viewBox="0 0 10 10"><path d="M2,5.2 L4.4,7.6 L8.4,2.8"></path></svg><span class="fl-wire__lbl fl-wire__lbl--grn">TRANSCRIBE</span></span><b class="fl-wire__ba-link"></b><span class="fl-wire__ba-step"><svg class="fl-wire__ba-mark" viewBox="0 0 10 10"><path d="M2,5.2 L4.4,7.6 L8.4,2.8"></path></svg><span class="fl-wire__lbl fl-wire__lbl--grn">TRANSLATE</span></span><b class="fl-wire__ba-link"></b><span class="fl-wire__ba-step"><svg class="fl-wire__ba-mark" viewBox="0 0 10 10"><path d="M2,5.2 L4.4,7.6 L8.4,2.8"></path></svg><span class="fl-wire__lbl fl-wire__lbl--grn">DUB</span></span><b class="fl-wire__ba-link"></b><span class="fl-wire__ba-step"><svg class="fl-wire__ba-mark" viewBox="0 0 10 10"><path d="M2,5.2 L4.4,7.6 L8.4,2.8"></path></svg><span class="fl-wire__lbl fl-wire__lbl--grn">APPROVE</span></span><b class="fl-wire__ba-link"></b><span class="fl-wire__cta"><span class="fl-wire__lbl">UPLOAD</span></span></span></div><div class="fl-wire__ba-body"><div class="fl-wire__ba-script"><span class="fl-wire__ba-head"><span class="fl-wire__lbl">ORIGINAL</span><span class="fl-wire__lbl">TRANSLATION</span></span><span class="fl-wire__ba-row" data-on=""><i class="fl-wire__ba-tick"></i><b class="fl-wire__ba-src">here&#x27;s what you need to know.</b><b class="fl-wire__ba-dst">これをチェックしてほしい。</b></span><span class="fl-wire__ba-row"><i class="fl-wire__ba-tick"></i><b class="fl-wire__ba-src">Loop Quiet for focus,</b><b class="fl-wire__ba-dst">集中にはLoop Quiet</b></span><span class="fl-wire__ba-row"><i class="fl-wire__ba-tick"></i><b class="fl-wire__ba-src">They are reusable</b><b class="fl-wire__ba-dst">Loopは再利用可能</b></span><span class="fl-wire__ba-row"><i class="fl-wire__ba-tick"></i><b class="fl-wire__ba-src">so you can find your perfect fit.</b><b class="fl-wire__ba-dst">完璧なフィットを見つけられる</b></span></div><div class="fl-wire__ba-video"><span class="fl-wire__ba-tabs"><i data-on=""></i><i></i><i></i></span><span class="fl-wire__ba-screen"><i class="fl-wire__ba-play"></i><i class="fl-wire__ba-capline"></i></span></div></div></div></div></span><span class="fl-shot__bar" aria-hidden="true"><i class="fl-shot__cue"></i>Watch walkthrough<b>1:09</b></span></button></div><ul class="fl-detail"><li class="fl-detail__plate" style="animation-delay:120ms"><span class="fl-detail__in"><span class="fl-detail__t">Proofreader integration</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Integrates proofreading in the loop without giving access to the full system.</span></span></li><li class="fl-detail__plate" style="animation-delay:175ms"><span class="fl-detail__in"><span class="fl-detail__t">Localization roadmap</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Expanding to other use-cases such as exporting PDP copy from Figma in bulk.</span></span></li><li class="fl-detail__plate" style="animation-delay:230ms"><span class="fl-detail__in"><span class="fl-detail__t">Custom review module</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Cultural judgment surfaced where it actually matters.</span></span></li><li class="fl-detail__plate" style="animation-delay:285ms"><span class="fl-detail__in"><span class="fl-detail__t">Single proofread surface</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Share-link review, no Figma seat needed.</span></span></li></ul></div></div></div></div></div>"`;

