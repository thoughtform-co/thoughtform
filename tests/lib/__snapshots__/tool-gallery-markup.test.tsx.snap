ire__he-box"></i><b class="fl-wire__he-name fl-wire__he-name--mid"></b><i class="fl-wire__he-status"></i></span><span class="fl-wire__he-row"><i class="fl-wire__he-box"></i><b class="fl-wire__he-name fl-wire__he-name--short"></b><i class="fl-wire__he-status"></i></span><span class="fl-wire__he-foot"><svg class="fl-wire__he-sync" viewBox="0 0 68 14" preserveAspectRatio="none"><path d="M0,0 H62 L68,6 V14 H6 L0,8 Z"></path></svg><span class="fl-wire__lbl">SYNC</span></span></div><div class="fl-wire__he-canvas"><span class="fl-wire__he-col fl-wire__he-col--ref"><svg viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet"><circle cx="15.5" cy="8" r="2.6"></circle><path d="M2,19 L9.5,11 L14,15.5 L17.5,12.5 L22,17"></path></svg></span><span class="fl-wire__he-col fl-wire__he-col--brief"><i class="fl-wire__he-hd"></i><b class="fl-wire__he-line"></b><b class="fl-wire__he-line fl-wire__he-line--short"></b><b class="fl-wire__he-line fl-wire__he-line--mid"></b></span><span class="fl-wire__he-col fl-wire__he-col--copy"><span class="fl-wire__he-var"><i class="fl-wire__he-hd"></i><b class="fl-wire__he-line fl-wire__he-line--short"></b></span><span class="fl-wire__he-var"><i class="fl-wire__he-hd"></i><b class="fl-wire__he-line fl-wire__he-line--mid"></b></span></span><span class="fl-wire__lbl fl-wire__he-cap">TEMPLATE</span></div></div></div></div></span><span class="fl-shot__bar" aria-hidden="true"><i class="fl-shot__cue"></i>Watch walkthrough<b>0:40</b></span></button></div><ul class="fl-detail"><li class="fl-detail__plate" style="animation-delay:120ms"><span class="fl-detail__in"><span class="fl-detail__t">Monday → Figma sync</span><i class="fl-detail__rule" aria-hidden="true"></i><span class="fl-detail__d">Structured briefings, GraphQL pipeline, instant Figma plugin update.</span></span></li><li class="fl-detail__plate" style="animation-delay:175ms"><span class="fl-detail__in"><span class="fl-detail__t">Frontify integration</span><i class="fl-detail__rule" aria-hidden="true"><